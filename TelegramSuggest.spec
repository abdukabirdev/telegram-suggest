# PyInstaller recipe for one TelegramSuggest.exe. Run build.bat rather than this directly.
# -*- mode: python ; coding: utf-8 -*-

from PyInstaller.utils.hooks import collect_submodules

# UI Automation wrappers generated by comtypes at build time (build.bat makes
# sure they exist): bundled, so the .exe never has to generate code at run time.
hidden = collect_submodules("comtypes.gen") + ["comtypes.stream"]

# Parts of Python and Qt the program never uses: a smaller, faster-starting .exe.
excluded = [
    "tkinter", "unittest", "pydoc", "doctest", "pdb", "test", "lib2to3", "xmlrpc",
    "PySide6.QtNetwork", "PySide6.QtQml", "PySide6.QtQuick", "PySide6.QtSql",
    "PySide6.QtTest", "PySide6.QtXml", "PySide6.QtDBus", "PySide6.QtOpenGL",
    "PySide6.QtOpenGLWidgets", "PySide6.QtPrintSupport", "PySide6.QtSvg",
    "PySide6.QtConcurrent", "PySide6.QtHelp", "PySide6.QtDesigner",
]

a = Analysis(
    ["TelegramSuggest.pyw"],
    pathex=[],
    binaries=[],
    datas=[],
    hiddenimports=hidden,
    hookspath=[],
    runtime_hooks=[],
    excludes=excluded,
    noarchive=False,
    optimize=1,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="TelegramSuggest",
    debug=False,
    strip=False,
    upx=False,                  # UPX-packed files upset antivirus programs
    runtime_tmpdir=None,
    console=False,
    icon="build/icon.ico",
    version="build/version_info.txt",
)
